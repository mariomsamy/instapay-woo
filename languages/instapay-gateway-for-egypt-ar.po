msgid "Payment Review"
msgstr "قيد مراجعة الدفع"

#. translators: %s: count
#: instapay-woo.php:347
#, php-format
msgid "Payment Review <span class=\"count\">(%s)</span>"
msgid_plural "Payment Review <span class=\"count\">(%s)</span>"
msgstr[0] "قيد مراجعة الدفع <span class=\"count\">(%s)</span>"
msgstr[1] "قيد مراجعة الدفع <span class=\"count\">(%s)</span>"
msgstr[2] "قيد مراجعة الدفع <span class=\"count\">(%s)</span>"
